#!/bin/sh
set -eu

project_directory=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)

environment_file_was_configured=false
if [ -n "${WALLAI_ENV_FILE:-}" ]; then
    environment_file=$WALLAI_ENV_FILE
    environment_file_was_configured=true
elif [ -f "$project_directory/.env.docker" ]; then
    environment_file=$project_directory/.env.docker
elif [ -f "$project_directory/.env" ]; then
    environment_file=$project_directory/.env
else
    environment_file=$project_directory/.env
fi

secrets_directory=${WALLAI_SECRETS_DIR:-$project_directory/.secrets}
backup_directory=${WALLAI_BACKUP_DIR:-$project_directory/backups}
build_local=false

configuration_value() {
    configuration_key="$1"

    if [ ! -f "$environment_file" ]; then
        return
    fi

    awk -F= -v key="$configuration_key" '
        $1 == key { sub(/^[^=]*=/, ""); value = $0; found = 1 }
        END { if (found) print value }
    ' "$environment_file"
}

load_manager_configuration() {
    export WALLAI_ENV_FILE="$environment_file"

    if [ -n "${WALLAI_BUILD_LOCAL:-}" ]; then
        build_local=$WALLAI_BUILD_LOCAL
        return
    fi

    configured_build_local=$(configuration_value WALLAI_BUILD_LOCAL)
    build_local=${configured_build_local:-false}
}

load_manager_configuration

compose() {
    https_domain=$(awk -F= '$1 == "WALLAI_DOMAIN" { print $2 }' "$environment_file" | tail -n 1)
    configured_project_name=$(awk -F= '$1 == "WALLAI_PROJECT_NAME" { print $2 }' "$environment_file" | tail -n 1)
    project_name=${WALLAI_PROJECT_NAME:-${configured_project_name:-wallai}}

    if [ "$build_local" = "true" ]; then
        if [ -n "$https_domain" ]; then
            docker compose --project-directory "$project_directory" --project-name "$project_name" --env-file "$environment_file" \
                -f "$project_directory/compose.yaml" -f "$project_directory/compose.build.yaml" \
                --profile https "$@"
        else
            docker compose --project-directory "$project_directory" --project-name "$project_name" --env-file "$environment_file" \
                -f "$project_directory/compose.yaml" -f "$project_directory/compose.build.yaml" "$@"
        fi
        return
    fi

    if [ -n "$https_domain" ]; then
        docker compose --project-directory "$project_directory" --project-name "$project_name" --env-file "$environment_file" \
            -f "$project_directory/compose.yaml" --profile https "$@"
    else
        docker compose --project-directory "$project_directory" --project-name "$project_name" --env-file "$environment_file" \
            -f "$project_directory/compose.yaml" "$@"
    fi
}

require_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        echo "Docker is required: https://docs.docker.com/engine/install/" >&2
        exit 1
    fi

    if ! docker compose version >/dev/null 2>&1; then
        echo "Docker Compose v2 is required." >&2
        exit 1
    fi

    compose_version=$(docker compose version --short | sed 's/^v//' | cut -d- -f1)
    if ! awk -v version="$compose_version" 'BEGIN {
        split(version, parts, ".")
        exit ! (parts[1] > 2 || (parts[1] == 2 && parts[2] >= 15))
    }'; then
        echo "Docker Compose 2.15 or newer is required; found $compose_version." >&2
        exit 1
    fi

    if ! docker info >/dev/null 2>&1; then
        echo "The Docker daemon is not available." >&2
        exit 1
    fi
}

random_base64() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 32 | tr -d '\r\n'
        return
    fi

    head -c 32 /dev/urandom | base64 | tr -d '\r\n'
}

write_checksum() {
    file_path="$1"
    file_directory=$(dirname "$file_path")
    file_name=$(basename "$file_path")

    if command -v sha256sum >/dev/null 2>&1; then
        (cd "$file_directory" && sha256sum "$file_name") > "$file_path.sha256"
    else
        (cd "$file_directory" && shasum -a 256 "$file_name") > "$file_path.sha256"
    fi
}

verify_checksum() {
    file_path="$1"

    if [ ! -f "$file_path.sha256" ]; then
        return
    fi

    file_directory=$(dirname "$file_path")
    checksum_file=$(basename "$file_path.sha256")

    if command -v sha256sum >/dev/null 2>&1; then
        (cd "$file_directory" && sha256sum --check "$checksum_file")
    else
        (cd "$file_directory" && shasum -a 256 --check "$checksum_file")
    fi
}

prepare_configuration() {
    if [ ! -f "$environment_file" ]; then
        cp "$project_directory/.env.docker.example" "$environment_file"
        chmod 600 "$environment_file"
        echo "Created $environment_file"
    fi

    chmod 600 "$environment_file"

    umask 077
    mkdir -p "$secrets_directory"

    if [ ! -s "$secrets_directory/app_key" ]; then
        printf 'base64:%s' "$(random_base64)" > "$secrets_directory/app_key"
    fi

    if [ ! -s "$secrets_directory/redis_password" ]; then
        random_base64 > "$secrets_directory/redis_password"
    fi

    chmod 600 "$secrets_directory/app_key" "$secrets_directory/redis_password"
}

set_environment_value() {
    configuration_key="$1"
    configuration_value="$2"
    temporary_environment_file=$(mktemp)

    awk -v key="$configuration_key" -v value="$configuration_value" '
        BEGIN { updated = 0 }
        index($0, key "=") == 1 {
            if (! updated) print key "=" value
            updated = 1
            next
        }
        { print }
        END { if (! updated) print key "=" value }
    ' "$environment_file" > "$temporary_environment_file"

    mv "$temporary_environment_file" "$environment_file"
    chmod 600 "$environment_file"
}

require_option_value() {
    option_name="$1"
    option_value=${2:-}

    if [ -z "$option_value" ]; then
        echo "$option_name requires a value." >&2
        exit 1
    fi
}

validate_domain() {
    domain="$1"

    case "$domain" in
        ''|*://*|*/*|*:*|.*|*.|*[!A-Za-z0-9.-]*)
            echo "Invalid domain: $domain" >&2
            exit 1
            ;;
    esac
}

validate_port() {
    port="$1"

    case "$port" in
        ''|*[!0-9]*)
            echo "Invalid port: $port" >&2
            exit 1
            ;;
    esac

    if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        echo "Invalid port: $port" >&2
        exit 1
    fi
}

validate_project_name() {
    project_name="$1"

    case "$project_name" in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*)
            echo "Invalid project name: $project_name" >&2
            exit 1
            ;;
    esac
}

validate_bind_address() {
    bind_address="$1"

    case "$bind_address" in
        ''|*[!A-Za-z0-9:._-]*)
            echo "Invalid bind address: $bind_address" >&2
            exit 1
            ;;
    esac
}

validate_image() {
    image="$1"

    case "$image" in
        ''|*[!A-Za-z0-9./:_-]*)
            echo "Invalid image: $image" >&2
            exit 1
            ;;
    esac
}

validate_version() {
    version="$1"

    case "$version" in
        ''|[.-]*|*[!A-Za-z0-9_.-]*)
            echo "Invalid version: $version" >&2
            exit 1
            ;;
    esac
}

require_configuration() {
    if [ ! -f "$environment_file" ]; then
        echo "WallAI is not configured. Run ./bin/wallai install or restore a backup." >&2
        exit 1
    fi

    for secret_file in app_key redis_password; do
        if [ ! -s "$secrets_directory/$secret_file" ]; then
            echo "Required secret is missing: $secrets_directory/$secret_file" >&2
            echo "Restore the original secret from backup; generating a replacement may make encrypted data unreadable." >&2
            exit 1
        fi
    done
}

pull_images() {
    if [ "$build_local" = "true" ]; then
        compose build --pull
    else
        compose pull
    fi
}

install_wallai() {
    install_local=false
    install_domain=''
    install_port=''
    install_version=''
    install_project_name=''
    install_bind_address=''
    install_image=''
    install_environment_file=''

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --local)
                install_local=true
                shift
                ;;
            --domain)
                require_option_value "$1" "${2:-}"
                install_domain=$2
                shift 2
                ;;
            --domain=*)
                install_domain=${1#*=}
                require_option_value --domain "$install_domain"
                shift
                ;;
            --port)
                require_option_value "$1" "${2:-}"
                install_port=$2
                shift 2
                ;;
            --port=*)
                install_port=${1#*=}
                require_option_value --port "$install_port"
                shift
                ;;
            --version)
                require_option_value "$1" "${2:-}"
                install_version=$2
                shift 2
                ;;
            --version=*)
                install_version=${1#*=}
                require_option_value --version "$install_version"
                shift
                ;;
            --project-name)
                require_option_value "$1" "${2:-}"
                install_project_name=$2
                shift 2
                ;;
            --project-name=*)
                install_project_name=${1#*=}
                require_option_value --project-name "$install_project_name"
                shift
                ;;
            --bind-address)
                require_option_value "$1" "${2:-}"
                install_bind_address=$2
                shift 2
                ;;
            --bind-address=*)
                install_bind_address=${1#*=}
                require_option_value --bind-address "$install_bind_address"
                shift
                ;;
            --image)
                require_option_value "$1" "${2:-}"
                install_image=$2
                shift 2
                ;;
            --image=*)
                install_image=${1#*=}
                require_option_value --image "$install_image"
                shift
                ;;
            --env-file)
                require_option_value "$1" "${2:-}"
                install_environment_file=$2
                shift 2
                ;;
            --env-file=*)
                install_environment_file=${1#*=}
                require_option_value --env-file "$install_environment_file"
                shift
                ;;
            -h|--help)
                show_install_help
                return
                ;;
            *)
                echo "Unknown install option: $1" >&2
                show_install_help >&2
                exit 1
                ;;
        esac
    done

    if [ "$install_local" = "true" ] && [ -n "$install_domain" ]; then
        echo "--local cannot be combined with --domain." >&2
        exit 1
    fi

    if [ -n "$install_domain" ] \
        && [ -n "$install_bind_address" ] \
        && [ "$install_bind_address" != "127.0.0.1" ] \
        && [ "$install_bind_address" != "::1" ]; then
        echo "--bind-address must remain loopback when --domain enables the HTTPS proxy." >&2
        exit 1
    fi

    if [ -n "$install_environment_file" ]; then
        case "$install_environment_file" in
            /*) environment_file=$install_environment_file ;;
            *) environment_file=$project_directory/$install_environment_file ;;
        esac
        environment_file_was_configured=true
    elif [ "$install_local" = "true" ] && [ "$environment_file_was_configured" = "false" ]; then
        environment_file=$project_directory/.env.docker
    fi

    export WALLAI_ENV_FILE="$environment_file"

    if [ -n "$install_domain" ]; then
        validate_domain "$install_domain"
    fi
    if [ -n "$install_port" ]; then
        validate_port "$install_port"
    fi
    if [ -n "$install_version" ]; then
        validate_version "$install_version"
    fi
    if [ -n "$install_project_name" ]; then
        validate_project_name "$install_project_name"
    fi
    if [ -n "$install_bind_address" ]; then
        validate_bind_address "$install_bind_address"
    fi
    if [ -n "$install_image" ]; then
        validate_image "$install_image"
    fi

    require_docker
    prepare_configuration

    if [ "$install_local" = "true" ]; then
        local_port=${install_port:-$(configuration_value WALLAI_PORT)}
        local_port=${local_port:-8080}
        local_project_name=${install_project_name:-wallai-local}

        set_environment_value APP_URL "http://wallai.localhost:$local_port"
        set_environment_value APP_ENV local
        set_environment_value APP_DEBUG true
        set_environment_value WALLAI_BUILD_LOCAL true
        set_environment_value WALLAI_IMAGE wallai
        set_environment_value WALLAI_VERSION "${install_version:-local}"
        set_environment_value WALLAI_PROJECT_NAME "$local_project_name"
        set_environment_value WALLAI_BIND_ADDRESS "${install_bind_address:-127.0.0.1}"
        set_environment_value WALLAI_PORT "$local_port"
        set_environment_value WALLAI_DOMAIN ''
        set_environment_value SESSION_SECURE_COOKIE false
        set_environment_value TRUSTED_HOSTS wallai.localhost,localhost,127.0.0.1
    elif [ -n "$install_domain" ]; then
        set_environment_value APP_URL "https://$install_domain"
        set_environment_value APP_ENV production
        set_environment_value APP_DEBUG false
        set_environment_value WALLAI_BUILD_LOCAL false
        set_environment_value WALLAI_DOMAIN "$install_domain"
        set_environment_value SESSION_SECURE_COOKIE true
        set_environment_value TRUSTED_HOSTS "$install_domain"
    fi

    if [ "$install_local" != "true" ] && [ -n "$install_port" ]; then
        set_environment_value WALLAI_PORT "$install_port"
        if [ -z "$install_domain" ]; then
            set_environment_value APP_URL "http://localhost:$install_port"
        fi
    fi
    if [ "$install_local" != "true" ] && [ -n "$install_project_name" ]; then
        set_environment_value WALLAI_PROJECT_NAME "$install_project_name"
    fi
    if [ "$install_local" != "true" ] && [ -n "$install_bind_address" ]; then
        set_environment_value WALLAI_BIND_ADDRESS "$install_bind_address"
    fi
    if [ "$install_local" != "true" ] && [ -n "$install_version" ]; then
        set_environment_value WALLAI_VERSION "$install_version"
    fi
    if [ -n "$install_image" ]; then
        set_environment_value WALLAI_IMAGE "$install_image"
    fi

    if [ "$install_local" = "true" ]; then
        build_local=true
    else
        load_manager_configuration
    fi

    pull_images
    compose up -d --wait

    application_url=$(configuration_value APP_URL)
    application_url=${application_url:-http://localhost:8080}

    echo
    echo "WallAI is ready at $application_url"
    echo "Complete the first-run setup in your browser."
    echo "Run ./bin/wallai doctor to verify the deployment at any time."
}

backup_wallai() {
    require_docker
    require_configuration
    mkdir -p "$backup_directory"

    timestamp=$(date -u '+%Y%m%dT%H%M%SZ')
    destination=${1:-$backup_directory/wallai-$timestamp.tar.gz}
    mkdir -p "$(dirname "$destination")"
    temporary_directory=$(mktemp -d)
    resumed=false

    cleanup_backup() {
        trap - EXIT INT TERM

        if [ -d "$temporary_directory" ]; then
            rm -r "$temporary_directory"
        fi

        if [ "$resumed" = "false" ]; then
            compose up -d web horizon scheduler >/dev/null 2>&1 || true
            compose exec -T web wallai-entrypoint php artisan up >/dev/null 2>&1 || true
        fi
    }

    trap cleanup_backup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    compose exec -T web wallai-entrypoint php artisan down --retry=30
    compose exec -T web wallai-entrypoint php artisan horizon:pause >/dev/null 2>&1 || true
    compose stop web horizon scheduler

    compose run --rm --no-deps --user 33:33 --entrypoint tar web \
        -czf - -C / var/lib/wallai app/storage/app/public/wallpapers \
        > "$temporary_directory/data.tar.gz"

    cp "$environment_file" "$temporary_directory/environment"
    cp -R "$secrets_directory" "$temporary_directory/secrets"
    wallai_version=$(awk -F= '$1 == "WALLAI_VERSION" { print $2 }' "$environment_file" | tail -n 1)
    printf 'created_at=%s\nwallai_version=%s\n' \
        "$timestamp" \
        "${wallai_version:-unknown}" \
        > "$temporary_directory/manifest"

    tar -czf "$destination" -C "$temporary_directory" .
    chmod 600 "$destination"
    write_checksum "$destination"

    compose up -d web horizon scheduler
    compose exec -T web wallai-entrypoint php artisan up
    resumed=true
    cleanup_backup

    echo "Backup created: $destination"
}

restore_wallai() {
    require_docker

    backup_file=${1:-}
    force=${2:-}

    if [ -z "$backup_file" ] || [ ! -f "$backup_file" ]; then
        echo "Usage: ./bin/wallai restore /path/to/backup.tar.gz [--force]" >&2
        exit 1
    fi

    verify_checksum "$backup_file"

    if [ "$force" != "--force" ]; then
        printf 'Restore this backup and replace all current WallAI data? [y/N] '
        read -r answer
        case "$answer" in
            y|Y|yes|YES) ;;
            *) echo "Restore cancelled."; exit 1 ;;
        esac
    fi

    temporary_directory=$(mktemp -d)
    trap 'rm -r "$temporary_directory"' EXIT INT TERM
    tar -xzf "$backup_file" -C "$temporary_directory"

    for required_file in data.tar.gz environment secrets/app_key secrets/redis_password; do
        if [ ! -f "$temporary_directory/$required_file" ]; then
            echo "Invalid WallAI backup: missing $required_file" >&2
            exit 1
        fi
    done

    if [ -f "$environment_file" ] \
        && [ -s "$secrets_directory/app_key" ] \
        && [ -s "$secrets_directory/redis_password" ]; then
        compose down
    fi

    cp "$temporary_directory/environment" "$environment_file"
    mkdir -p "$secrets_directory"
    cp "$temporary_directory/secrets/app_key" "$secrets_directory/app_key"
    cp "$temporary_directory/secrets/redis_password" "$secrets_directory/redis_password"
    chmod 600 "$environment_file" "$secrets_directory/app_key" "$secrets_directory/redis_password"

    compose run --rm --no-deps --user 33:33 \
        --entrypoint /bin/sh web \
        -ec 'rm -rf /var/lib/wallai/* /app/storage/app/public/wallpapers/* && tar -xzf - -C /' \
        < "$temporary_directory/data.tar.gz"

    compose up -d --wait
    echo "WallAI restored successfully from $backup_file"
}

update_wallai() {
    require_docker
    require_configuration
    backup_wallai
    pull_images
    compose stop web horizon scheduler
    compose up -d --force-recreate --wait
    compose exec -T web wallai-entrypoint php artisan schedule:interrupt >/dev/null 2>&1 || true
    echo "WallAI was updated successfully."
}

show_help() {
    cat <<'EOF'
WallAI self-hosting manager

Usage: ./bin/wallai <command> [options]

Commands:
  install [options]       Configure, build or pull, and start WallAI
  up                      Start WallAI
  down                    Stop WallAI without deleting data
  restart                 Restart all services
  status                  Show container status
  logs [service]          Follow application logs
  doctor                  Run deployment diagnostics
  backup [path]           Create a database, wallpaper, and secret backup
  restore <path> [--force] Restore a backup, replacing current data
  update                  Back up, pull, migrate, and restart WallAI
  reset                   Return WallAI to first-run state (destructive)
  uninstall               Remove containers; named data volumes are preserved
EOF
}

show_install_help() {
    cat <<'EOF'
Usage: ./bin/wallai install [options]

Options:
  --local                 Build the current source and use .env.docker
  --domain <hostname>     Configure bundled HTTPS for a public domain
  --port <port>           Set the loopback HTTP port (default: 8080)
  --version <tag>         Set the container version (default: latest)
  --project-name <name>   Set the Compose project and volume prefix
  --bind-address <address> Set the direct HTTP bind address
  --image <repository>    Set the container image repository
  --env-file <path>       Use a custom deployment environment file
  -h, --help              Show install options

Examples:
  ./bin/wallai install --local
  ./bin/wallai install --domain wallai.example.com --version 2.1.0
EOF
}

command_name=${1:-help}
shift || true

case "$command_name" in
    install) install_wallai "$@" ;;
    up) require_docker; require_configuration; compose up -d --wait ;;
    down) require_docker; require_configuration; compose down ;;
    restart) require_docker; require_configuration; compose down; compose up -d --wait ;;
    status) require_docker; require_configuration; compose ps ;;
    logs) require_docker; require_configuration; compose logs --follow --tail=200 "$@" ;;
    doctor)
        require_docker
        require_configuration
        if [ "$(configuration_value APP_ENV)" = "production" ]; then
            compose exec -T web wallai-entrypoint php artisan wallai:doctor --deployment --runtime
        else
            compose exec -T web wallai-entrypoint php artisan wallai:doctor --runtime
        fi
        ;;
    backup) backup_wallai "${1:-}" ;;
    restore) restore_wallai "${1:-}" "${2:-}" ;;
    update) update_wallai ;;
    reset) require_docker; require_configuration; compose exec web wallai-entrypoint php artisan wallai:reset ;;
    uninstall) require_docker; require_configuration; compose down ;;
    help|-h|--help) show_help ;;
    *) echo "Unknown command: $command_name" >&2; show_help; exit 1 ;;
esac
